# 作業ディレクトリの作成
mkdir ~/ospf-diamond-lab && cd ~/ospf-diamond-lab
mkdir -p config/r1 config/r2 config/r3 config/r4

# 各ルーター共通のデーモン設定（OSPFを有効化）
cat << 'EOF' > config/daemons
zebra=yes
bgpd=no
ospfd=yes
ospf6d=no
ripd=no
ripngd=no
isisd=no
EOF

# R1の設定 (Loopback: 1.1.1.1)
cat << 'EOF' > config/r1/frr.conf
frr version 8.4
frr defaults traditional
hostname r1
!
interface lo
 ip address 1.1.1.1/32
!
interface eth1
 ip address 10.0.12.1/24
 ip ospf network point-to-point
!
interface eth2
 ip address 10.0.13.1/24
 ip ospf network point-to-point
!
router ospf
 network 10.0.12.0/24 area 0
 network 10.0.13.0/24 area 0
 network 1.1.1.1/32 area 0
EOF

# R2の設定
cat << 'EOF' > config/r2/frr.conf
