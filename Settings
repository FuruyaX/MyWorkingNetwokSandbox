# Containerlabのトポロジー定義ファイル作成
cat << 'EOF' > topology.clab.yml
name: ospf-diamond
topology:
  nodes:
    r1:
      kind: linux
      image: frrouting/frr:v8.4.0
      binds:
        - config/r1/frr.conf:/etc/frr/frr.conf
        - config/daemons:/etc/frr/daemons
    r2:
      kind: linux
      image: frrouting/frr:v8.4.0
      binds:
        - config/r2/frr.conf:/etc/frr/frr.conf
        - config/daemons:/etc/frr/daemons
    r3:
      kind: linux
      image: frrouting/frr:v8.4.0
      binds:
        - config/r3/frr.conf:/etc/frr/frr.conf
        - config/daemons:/etc/frr/daemons
    r4:
      kind: linux
      image: frrouting/frr:v8.4.0
      binds:
        - config/r4/frr.conf:/etc/frr/frr.conf
        - config/daemons:/etc/frr/daemons

  links:
    - endpoints: ["r1:eth1", "r2:eth1"]
    - endpoints: ["r1:eth2", "r3:eth1"]
    - endpoints: ["r2:eth2", "r4:eth1"]
    - endpoints: ["r3:eth2", "r4:eth2"]
EOF
